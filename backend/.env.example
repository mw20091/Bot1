# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_bot
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=whatsapp_bot

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRE=7d

# Bot Settings
BOT_WEBHOOK_SECRET=your-webhook-secret
BOT_AUTO_READ=true
BOT_AUTO_REACTIONS=true
BOT_AUTO_STATUS_LIKE=true
BOT_TYPING_DELAY=1000

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
